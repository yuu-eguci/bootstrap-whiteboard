{
  "name": "bootstrap-whiteboard",
  "private": true,
  "description": "The repository that is for the bootstrap test on the GitHub Pages.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "serve": "node scripts/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "5.14.0",
    "@playwright/test": "1.64.1",
    "bootstrap": "4.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "jquery": "3.5.1",
    "popper.js": "1.16.1"
  }
}
