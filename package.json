{
  "name": "bootstrap-whiteboard",
  "private": true,
  "description": "The repository that is for the bootstrap test on the GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.json",
    "serve": "node scripts/serve.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "5.14.0",
    "@playwright/test": "1.65.1",
    "@types/jquery": "3.5.34",
    "@types/node": "26.6.6",
    "bootstrap": "4.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jquery": "3.5.1",
    "popper.js": "1.16.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
